{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bptb/coupon-box",
  "title": "Coupon Box",
  "description": "Coupon and deal box with click-to-copy code, reveal mode, expiry countdown, and affiliate CTA.",
  "category": "widgets",
  "version": "2.1.0",
  "keywords": [
    "coupon",
    "deal",
    "discount code",
    "promo code",
    "affiliate"
  ],
  "textdomain": "b-pricing-table",
  "attributes": {
    "deal": {
      "type": "object",
      "default": {
        "discount": {
          "enabled": true,
          "text": "25% OFF",
          "subText": "Limited time"
        },
        "title": "Spring Sale — 25% off all annual plans",
        "description": "Applies to first-year billing on any annual plan. Stack with student pricing.",
        "badge": {
          "enabled": true,
          "text": "Verified",
          "icon": "check"
        },
        "brand": {
          "showLogo": false,
          "logoId": 0,
          "logoUrl": "",
          "logoAlt": "",
          "name": "",
          "showName": false
        }
      }
    },
    "code": {
      "type": "object",
      "default": {
        "value": "SPRING25",
        "mode": "copy",
        "copyLabel": "Copy",
        "copiedLabel": "Copied!",
        "showCopyIcon": true,
        "revealLabel": "Click to Reveal Code",
        "revealCopiesCode": true,
        "revealOpensCta": false,
        "uppercase": true,
        "prefixText": "Use code:"
      }
    },
    "cta": {
      "type": "object",
      "default": {
        "enabled": true,
        "text": "Redeem at checkout",
        "url": "#",
        "isNewTab": true,
        "rel": "nofollow sponsored",
        "clickCopiesCode": false,
        "icon": "arrow"
      }
    },
    "expiry": {
      "type": "object",
      "default": {
        "enabled": true,
        "mode": "countdown",
        "dateTime": "",
        "text": "Ends Sunday",
        "countdown": {
          "showDays": true,
          "showSeconds": true,
          "labels": {
            "days": "Days",
            "hours": "Hrs",
            "minutes": "Min",
            "seconds": "Sec"
          }
        },
        "onExpire": "showExpired",
        "expiredText": "Deal expired",
        "prefixLabel": "Hurry — offer ends in:"
      }
    },
    "terms": {
      "type": "object",
      "default": {
        "enabled": true,
        "label": "Terms & Conditions",
        "content": "Valid for new annual subscriptions only. One use per customer. Cannot be combined with other offers.",
        "defaultOpen": false
      }
    },
    "layout": {
      "type": "object",
      "default": {
        "preset": "ticket",
        "notches": {
          "enabled": true,
          "color": "#f8fafc"
        },
        "stubPosition": "left",
        "stubWidth": {
          "desktop": "32%",
          "tablet": "36%",
          "mobile": "100%"
        },
        "contentWidth": {
          "desktop": "680px",
          "tablet": "100%",
          "mobile": "100%"
        },
        "align": "left",
        "gap": {
          "desktop": "0px",
          "tablet": "0px",
          "mobile": "0px"
        },
        "stackOn": "mobile"
      }
    },
    "styles": {
      "type": "object",
      "default": {
        "container": {
          "width": {
            "desktop": "100%",
            "tablet": "100%",
            "mobile": "100%"
          },
          "bg": {
            "type": "solid",
            "color": "#ffffff"
          },
          "border": {
            "color": "#e2e8f0",
            "width": "1px",
            "style": "solid"
          },
          "radius": {
            "top": "16px",
            "right": "16px",
            "bottom": "16px",
            "left": "16px"
          },
          "shadow": [
            {
              "hOffset": "0px",
              "vOffset": "16px",
              "blur": "36px",
              "spreed": "0px",
              "color": "#6366f121",
              "isInset": false
            }
          ],
          "hoverShadow": [
            {
              "hOffset": "0px",
              "vOffset": "20px",
              "blur": "44px",
              "spreed": "0px",
              "color": "#6366f130",
              "isInset": false
            }
          ],
          "padding": {
            "desktop": {
              "top": "0px",
              "right": "0px",
              "bottom": "0px",
              "left": "0px"
            },
            "tablet": {
              "top": "0px",
              "right": "0px",
              "bottom": "0px",
              "left": "0px"
            },
            "mobile": {
              "top": "0px",
              "right": "0px",
              "bottom": "0px",
              "left": "0px"
            }
