            "color": "#cbd5e1",
            "style": "dashed",
            "width": "2px"
          }
        },
        "discountText": {
          "typo": {
            "fontFamily": "Manrope",
            "fontCategory": "sans-serif",
            "fontWeight": 800,
            "fontVariant": "800",
            "fontSize": {
              "desktop": 28,
              "tablet": 24,
              "mobile": 22
